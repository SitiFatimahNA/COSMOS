    <string name="planet_mercury_desc">Merkurius adalah planet terkecil di Tata Surya sekaligus yang paling dekat dengan Matahari. Permukaannya dipenuhi kawah tumbukan dan hampir tidak memiliki atmosfer untuk menahan panas.</string>
    <string name="planet_mercury_distance">57,9 juta km</string>
    <string name="planet_mercury_diameter">4.879 km</string>
    <string name="planet_mercury_rotation">58,6 hari Bumi</string>
    <string name="planet_mercury_revolution">88 hari Bumi</string>
    <string name="planet_mercury_moons">0 satelit</string>
    <string name="planet_mercury_temp">-180 °C hingga 430 °C</string>
    <string name="planet_mercury_fact">Karena tidak memiliki atmosfer tebal, suhu Merkurius berubah drastis antara siang dan malam, dan satu hari matahari di Merkurius setara dengan 176 hari Bumi.</string>

    <string name="planet_venus_desc">Venus adalah planet terpanas di Tata Surya meskipun bukan yang terdekat dengan Matahari. Atmosfer karbon dioksidanya yang sangat tebal menimbulkan efek rumah kaca ekstrem.</string>
    <string name="planet_venus_distance">108,2 juta km</string>
    <string name="planet_venus_diameter">12.104 km</string>
    <string name="planet_venus_rotation">243 hari Bumi</string>
    <string name="planet_venus_revolution">225 hari Bumi</string>
    <string name="planet_venus_moons">0 satelit</string>
    <string name="planet_venus_temp">465 °C</string>
    <string name="planet_venus_fact">Venus berotasi berlawanan arah dengan sebagian besar planet lain, sehingga Matahari terbit dari barat dan terbenam di timur, serta satu harinya lebih lama dari satu tahunnya.</string>

    <string name="planet_earth_desc">Bumi adalah planet ketiga dari Matahari dan satu-satunya dunia yang diketahui mendukung kehidupan. Sekitar 71% permukaannya tertutup air cair dengan atmosfer pelindung yang kaya nitrogen dan oksigen.</string>
    <string name="planet_earth_distance">149,6 juta km</string>
    <string name="planet_earth_diameter">12.742 km</string>
    <string name="planet_earth_rotation">23,9 jam</string>
    <string name="planet_earth_revolution">365,25 hari</string>
    <string name="planet_earth_moons">1 satelit (Bulan)</string>
    <string name="planet_earth_temp">15 °C (rata-rata)</string>
    <string name="planet_earth_fact">Bumi merupakan planet terpadat di Tata Surya dan memiliki medan magnet kuat yang melindungi kehidupan dari radiasi angin Matahari.</string>

    <string name="planet_mars_desc">Mars dikenal sebagai Planet Merah karena kandungan oksida besi pada permukaannya. Planet ini memiliki lembah ngarai raksasa, tudung es kutub, serta gunung berapi terbesar di Tata Surya.</string>
    <string name="planet_mars_distance">227,9 juta km</string>
    <string name="planet_mars_diameter">6.779 km</string>
    <string name="planet_mars_rotation">24,6 jam</string>
    <string name="planet_mars_revolution">687 hari Bumi</string>
    <string name="planet_mars_moons">2 satelit (Phobos &amp; Deimos)</string>
    <string name="planet_mars_temp">-65 °C (rata-rata)</string>
    <string name="planet_mars_fact">Gunung Olympus Mons di Mars menjulang setinggi sekitar 21,9 km, hampir tiga kali lipat tinggi Gunung Everest di Bumi.</string>

    <string name="planet_jupiter_desc">Jupiter adalah planet terbesar di Tata Surya yang tersusun terutama dari gas hidrogen dan helium. Ciri khasnya adalah Bintik Merah Raksasa, badai anticyclone raksasa yang telah berlangsung ratusan tahun.</string>
    <string name="planet_jupiter_distance">778,5 juta km</string>
    <string name="planet_jupiter_diameter">139.820 km</string>
    <string name="planet_jupiter_rotation">9,9 jam</string>
    <string name="planet_jupiter_revolution">11,86 tahun Bumi</string>
    <string name="planet_jupiter_moons">95 satelit</string>
    <string name="planet_jupiter_temp">-110 °C</string>
    <string name="planet_jupiter_fact">Jupiter memiliki rotasi tercepat di antara semua planet Tata Surya, dan satelitnya Ganymede lebih besar daripada planet Merkurius.</string>

    <string name="planet_saturn_desc">Saturnus adalah raksasa gas kedua terbesar yang terkenal dengan sistem cincinnya yang luas dan berkilau. Cincin tersebut terdiri atas miliaran partikel es, debu, dan pecahan batu.</string>
    <string name="planet_saturn_distance">1.434 juta km</string>
    <string name="planet_saturn_diameter">116.460 km</string>
    <string name="planet_saturn_rotation">10,7 jam</string>
    <string name="planet_saturn_revolution">29,45 tahun Bumi</string>
    <string name="planet_saturn_moons">146 satelit</string>
    <string name="planet_saturn_temp">-140 °C</string>
    <string name="planet_saturn_fact">Massa jenis rata-rata Saturnus lebih kecil daripada air, dan kutub utaranya memiliki pola badai berbentuk segi enam raksasa yang unik.</string>

    <string name="planet_uranus_desc">Uranus adalah raksasa es berwarna biru kehijauan akibat kandungan gas metana di atmosfernya. Planet ini berotasi miring ekstrem hampir sejajar dengan bidang orbitnya.</string>
    <string name="planet_uranus_distance">2.871 juta km</string>
    <string name="planet_uranus_diameter">50.724 km</string>
    <string name="planet_uranus_rotation">17,2 jam</string>
    <string name="planet_uranus_revolution">84 tahun Bumi</string>
    <string name="planet_uranus_moons">28 satelit</string>
    <string name="planet_uranus_temp">-195 °C</string>
    <string name="planet_uranus_fact">Uranus merupakan planet pertama yang ditemukan menggunakan teleskop pada tahun 1781 oleh William Herschel, dengan kemiringan sumbu sekitar 98 derajat.</string>

    <string name="planet_neptune_desc">Neptunus adalah planet terjauh dari Matahari yang berwarna biru pekat. Raksasa es ini dikenal memiliki angin supersonik terkuat di seluruh Tata Surya.</string>
    <string name="planet_neptune_distance">4.495 juta km</string>
    <string name="planet_neptune_diameter">49.244 km</string>
    <string name="planet_neptune_rotation">16,1 jam</string>
    <string name="planet_neptune_revolution">164,8 tahun Bumi</string>
    <string name="planet_neptune_moons">16 satelit</string>
    <string name="planet_neptune_temp">-200 °C</string>
    <string name="planet_neptune_fact">Kecepatan angin di atmosfer Neptunus dapat melampaui 2.100 km/jam, dan satelit terbesarnya Triton mengorbit berlawanan arah dengan rotasi planet.</string>

