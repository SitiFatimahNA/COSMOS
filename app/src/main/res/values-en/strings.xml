    <string name="planet_mercury_desc">Mercury is the smallest planet in the Solar System and the closest to the Sun. Its heavily cratered surface has almost no atmosphere to retain heat.</string>
    <string name="planet_mercury_distance">57.9 million km</string>
    <string name="planet_mercury_diameter">4,879 km</string>
    <string name="planet_mercury_rotation">58.6 Earth days</string>
    <string name="planet_mercury_revolution">88 Earth days</string>
    <string name="planet_mercury_moons">0 moons</string>
    <string name="planet_mercury_temp">-180 °C to 430 °C</string>
    <string name="planet_mercury_fact">Without a thick atmosphere, Mercury experiences extreme temperature swings, and a single solar day on Mercury lasts as long as 176 Earth days.</string>

    <string name="planet_venus_desc">Venus is the hottest planet in the Solar System despite not being the closest to the Sun. Its dense carbon dioxide atmosphere traps heat in a runaway greenhouse effect.</string>
    <string name="planet_venus_distance">108.2 million km</string>
    <string name="planet_venus_diameter">12,104 km</string>
    <string name="planet_venus_rotation">243 Earth days</string>
    <string name="planet_venus_revolution">225 Earth days</string>
    <string name="planet_venus_moons">0 moons</string>
    <string name="planet_venus_temp">465 °C</string>
    <string name="planet_venus_fact">Venus spins backwards compared to most planets, meaning the Sun rises in the west and sets in the east, and its day is longer than its year.</string>

    <string name="planet_earth_desc">Earth is the third planet from the Sun and the only known world to support life. Roughly 71% of its surface is covered in liquid water beneath a protective nitrogen-oxygen atmosphere.</string>
    <string name="planet_earth_distance">149.6 million km</string>
    <string name="planet_earth_diameter">12,742 km</string>
    <string name="planet_earth_rotation">23.9 hours</string>
    <string name="planet_earth_revolution">365.25 days</string>
    <string name="planet_earth_moons">1 moon (The Moon)</string>
    <string name="planet_earth_temp">15 °C (average)</string>
    <string name="planet_earth_fact">Earth is the densest planet in the Solar System and generates a powerful magnetic field that shields life from harmful solar wind radiation.</string>

    <string name="planet_mars_desc">Mars is known as the Red Planet due to iron oxide dust covering its surface. It hosts giant canyon systems, polar ice caps, and the tallest volcano in the Solar System.</string>
    <string name="planet_mars_distance">227.9 million km</string>
    <string name="planet_mars_diameter">6,779 km</string>
    <string name="planet_mars_rotation">24.6 hours</string>
    <string name="planet_mars_revolution">687 Earth days</string>
    <string name="planet_mars_moons">2 moons (Phobos &amp; Deimos)</string>
    <string name="planet_mars_temp">-65 °C (average)</string>
    <string name="planet_mars_fact">Olympus Mons on Mars rises roughly 21.9 km high — nearly three times the height of Mount Everest on Earth.</string>

    <string name="planet_jupiter_desc">Jupiter is the largest planet in the Solar System, composed mainly of hydrogen and helium. Its signature Great Red Spot is a massive anticyclonic storm that has raged for centuries.</string>
    <string name="planet_jupiter_distance">778.5 million km</string>
    <string name="planet_jupiter_diameter">139,820 km</string>
    <string name="planet_jupiter_rotation">9.9 hours</string>
    <string name="planet_jupiter_revolution">11.86 Earth years</string>
    <string name="planet_jupiter_moons">95 moons</string>
    <string name="planet_jupiter_temp">-110 °C</string>
    <string name="planet_jupiter_fact">Jupiter has the fastest rotation of any planet in the Solar System, and its largest moon Ganymede is bigger than the planet Mercury.</string>

    <string name="planet_saturn_desc">Saturn is the second-largest gas giant, famous for its vast and dazzling ring system made of billions of ice crystals, dust, and rocky fragments.</string>
    <string name="planet_saturn_distance">1,434 million km</string>
    <string name="planet_saturn_diameter">116,460 km</string>
    <string name="planet_saturn_rotation">10.7 hours</string>
    <string name="planet_saturn_revolution">29.45 Earth years</string>
    <string name="planet_saturn_moons">146 moons</string>
    <string name="planet_saturn_temp">-140 °C</string>
    <string name="planet_saturn_fact">Saturn has an average density lower than water, and its north pole features a giant, persistent hexagonal jet-stream storm.</string>

    <string name="planet_uranus_desc">Uranus is a pale cyan ice giant whose color comes from methane gas in its upper atmosphere. It rotates almost completely on its side relative to its orbital plane.</string>
    <string name="planet_uranus_distance">2,871 million km</string>
    <string name="planet_uranus_diameter">50,724 km</string>
    <string name="planet_uranus_rotation">17.2 hours</string>
    <string name="planet_uranus_revolution">84 Earth years</string>
    <string name="planet_uranus_moons">28 moons</string>
    <string name="planet_uranus_temp">-195 °C</string>
    <string name="planet_uranus_fact">Uranus was the first planet discovered with a telescope in 1781 by William Herschel, and its axis is tilted at roughly 98 degrees.</string>

    <string name="planet_neptune_desc">Neptune is the farthest known major planet from the Sun, glowing a deep vivid blue. This ice giant is home to the fastest supersonic winds in the Solar System.</string>
    <string name="planet_neptune_distance">4,495 million km</string>
    <string name="planet_neptune_diameter">49,244 km</string>
    <string name="planet_neptune_rotation">16.1 hours</string>
    <string name="planet_neptune_revolution">164.8 Earth years</string>
    <string name="planet_neptune_moons">16 moons</string>
    <string name="planet_neptune_temp">-200 °C</string>
    <string name="planet_neptune_fact">Winds in Neptune\'s atmosphere can exceed 2,100 km/h, and its largest moon Triton orbits in the opposite direction of the planet\'s rotation.</string>

